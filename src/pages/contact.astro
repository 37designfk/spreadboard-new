---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="ja" pagePath="/contact" title="CONTACT"
  description="SPREAD SNOWBOARDSへのお問い合わせ。製品についてのご質問、ご注文等はこちらから。"
>
  <section class="page-header">
    <div class="page-header-inner">
      <p class="page-label">GET IN TOUCH</p>
      <h1 class="page-title">CONTACT</h1>
    </div>
  </section>

  <div class="form-wrap">
    <p class="form-intro">
      製品についてのご質問、お取り扱いのご相談、その他お問い合わせは<br />
      以下のフォームよりお気軽にご連絡ください。
    </p>

    <form id="contact-form" class="contact-form">
      <input type="hidden" name="site_id" value="spreadboard" />
      <!-- ハニーポット。botが埋めると送信を黙って捨てる -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-hp" />

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">お名前 <span class="required">*</span></label>
          <input type="text" name="name" required placeholder="山田 太郎" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">メールアドレス <span class="required">*</span></label>
          <input type="email" name="email" required placeholder="your@email.com" class="form-input" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">件名</label>
        <select name="subject" class="form-input form-select">
          <option value="">選択してください</option>
          <option value="product">製品について</option>
          <option value="shop">取り扱い店舗について</option>
          <option value="dealer">販売代理店について</option>
          <option value="other">その他</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">メッセージ <span class="required">*</span></label>
        <textarea name="message" required rows="6" placeholder="お問い合わせ内容をご記入ください" class="form-input form-textarea"></textarea>
      </div>

      <button type="submit" class="form-submit">
        <span>SEND MESSAGE</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M2 7H12M8 3L12 7L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <p class="form-status" id="contact-status" aria-live="polite"></p>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status') as HTMLElement;
  const button = form.querySelector('.form-submit') as HTMLButtonElement;

  const MSG = {
    sending: '送信中...',
    success: '送信しました。担当より追ってご連絡いたします。',
    error: '送信に失敗しました。お手数ですが時間をおいて再度お試しください。',
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    status.className = 'form-status is-sending';
    status.textContent = MSG.sending;

    const fd = new FormData(form);
    // 件名は value("product"等)ではなく画面に出ている日本語ラベルを送る。
    // 受信側は通知メールをそのまま読むだけで内容が分かる
    const sel = form.querySelector('select[name="subject"]') as HTMLSelectElement | null;
    if (sel && sel.selectedIndex > 0) {
      fd.set('subject', sel.options[sel.selectedIndex].text);
    }

    try {
      const res = await fetch('https://forms.37d.jp/submit', { method: 'POST', body: fd });
      const data = await res.json();
      if (data.ok) {
        status.className = 'form-status is-success';
        status.textContent = MSG.success;
        form.reset();
      } else {
        status.className = 'form-status is-error';
        status.textContent = MSG.error;
      }
    } catch {
      status.className = 'form-status is-error';
      status.textContent = MSG.error;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .page-header {
    border-bottom: 1px solid #ebebeb;
    padding: 3rem 1.5rem 2rem;
  }
  .page-header-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .page-label {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 10px;
    letter-spacing: 4px;
    color: #cc0000;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .page-title {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 900;
    font-style: italic;
    letter-spacing: 2px;
    color: #111;
  }

  .form-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .form-intro {
    font-size: 13px;
    color: rgba(0,0,0,0.6);
    line-height: 2;
    margin-bottom: 3rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-label {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(0,0,0,0.5);
    text-transform: uppercase;
  }
  .required {
    color: #cc0000;
  }
  .form-input {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(0,0,0,0.12);
    color: #111;
    font-size: 14px;
    padding: 12px 16px;
    font-family: inherit;
    transition: border-color 0.2s;
  }
  .form-input:focus {
    outline: none;
    border-color: rgba(0,0,0,0.5);
  }
  .form-input::placeholder {
    color: rgba(0,0,0,0.3);
  }
  .form-select {
    background: #fff;
    color: rgba(0,0,0,0.6);
  }
  .form-textarea {
    resize: none;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    background: #111;
    color: #fff;
    border: none;
    cursor: pointer;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 13px 28px;
    transition: background 0.2s;
  }
  .form-submit:hover {
    background: #cc0000;
  }
  .form-submit:disabled {
    background: rgba(0, 0, 0, 0.3);
    cursor: default;
  }

  /* ハニーポット。画面外に飛ばす。display:none だと埋めない bot がいる */
  .form-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-status {
    font-size: 13px;
    line-height: 1.8;
    min-height: 1.8em;
  }
  .form-status.is-sending {
    color: rgba(0, 0, 0, 0.5);
  }
  .form-status.is-success {
    color: #111;
  }
  .form-status.is-error {
    color: #cc0000;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
